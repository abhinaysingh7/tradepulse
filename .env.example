# TradePulse — Server Environment Configuration
PORT=5001
NODE_ENV=development

# Finnhub API Key (Kept securely on the backend, never exposed to frontend)
# Obtain a free token at https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key_here

# Production Frontend Origin (Used by Express CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: Frontend API Base URL (leave blank to use relative /api proxy)
# VITE_API_BASE_URL=http://localhost:5001
